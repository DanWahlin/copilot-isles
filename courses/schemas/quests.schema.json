{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's quests for one island (courses/<id>/quests/<island>.json)",
  "description": "The island's quests (story order), the compass's labels, the tracker's header, every named script its NPCs and puzzles play (src/game/script.ts), which script or line each NPC offers when (beats), the conditions and events the game asks the island's story for (story), and its NPCs' barks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["island", "tracker", "quests", "targets", "scripts", "barks"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "island": {
      "description": "The game's island id.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter", "goal", "next"],
      "properties": {
        "chapter": {
          "$ref": "#/$defs/text"
        },
        "goal": {
          "$ref": "#/$defs/text"
        },
        "next": {
          "description": "What's next once every task's done.",
          "$ref": "#/$defs/text"
        },
        "nextSail": {
          "description": "Anchorage: what's next once the next island is open (it replaces next).",
          "$ref": "#/$defs/text"
        }
      }
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "task", "steps"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "task": {
            "$ref": "#/$defs/text"
          },
          "optional": {
            "type": "boolean"
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "steps": {
            "description": "Step id → what the Logbook and tracker say to do next. \"done\" marks completion.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "targets": {
      "description": "\"<quest>:<step>\" → where the compass points (interaction ids; a trailing * matches a prefix) and its label.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[\\w.]+:[\\w-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ids", "label"],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "notes": {
      "description": "What each script (or bark) is for, for authors. The game ignores it.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "barks": {
      "description": "NPC id → the unvoiced lines they say when the game has no script for them.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "beats": {
      "type": "array",
      "description": "Which script or line each NPC offers for the quest state (src/game/beats.ts): the first row for the NPC whose `when` holds wins; no row means the NPC barks.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["npc"],
        "properties": {
          "npc": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            ]
          },
          "when": {
            "$ref": "#/$defs/when"
          },
          "script": {
            "$ref": "#/$defs/id",
            "description": "Plays a script of this island."
          },
          "say": {
            "type": "string",
            "pattern": "^[\\w.-]+$",
            "description": "Plays one voiced line."
          },
          "none": {
            "const": true,
            "description": "Nothing to offer (the NPC barks)."
          }
        }
      }
    },
    "story": {
      "type": "object",
      "description": "The game's quest skeleton on this island, in this course's quests (src/game/story.ts): the conditions and events the game asks for by name (STORY_CONDITIONS, STORY_EVENTS). A course that uses the island defines every name the game asks for there.",
      "additionalProperties": false,
      "required": ["conditions", "events"],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "conditions": {
          "description": "Name → when it holds (e.g. \"sealed\": {\"Q0.10\": \"done\"}).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/when"
          }
        },
        "events": {
          "description": "Name → rules applied in order when it happens, each read against the steps the rules before it set (e.g. \"setSail\": [{\"when\": {\"Q0.11\": \"sail\"}, \"set\": {\"Q0.11\": \"done\"}}]).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z]*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rule"
            }
          }
        }
      }
    },
    "signs": {
      "type": "object",
      "description": "The island's signs with course words, by the names the game asks for (ISLAND_SIGNS, src/course/pack.ts): Thousand-Bough's \"loft\", the board over the top deck's house.",
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.:-]*$"
    },
    "step": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["say"],
          "properties": {
            "say": {
              "description": "A voiced line (voice/lines.json).",
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "description": "An unvoiced line ({captain}, {ship} and the setup tokens are filled in).",
              "$ref": "#/$defs/text"
            },
            "speaker": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["show"],
          "properties": {
            "show": {
              "description": "A course image id (a chapter's images) in the spyglass.",
              "type": "string"
            },
            "caption": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hide"],
          "properties": {
            "hide": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quiz"],
          "properties": {
            "quiz": {
              "$ref": "#/$defs/id"
            },
            "when": {
              "anyOf": [
                {
                  "enum": ["model:auto", "model:picked", "branch:given", "issue:given"]
                },
                {
                  "type": "string",
                  "pattern": "^app:[A-Za-z0-9][\\w.:-]*$",
                  "description": "A real-app task (learning.json) the player confirmed."
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["page"],
          "properties": {
            "page": {
              "$ref": "#/$defs/id"
            },
            "doubloons": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "description": "Shelves a page in the Logbook without a reveal card.",
              "$ref": "#/$defs/id"
            },
            "doubloons": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["term"],
          "properties": {
            "term": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quest", "step"],
          "properties": {
            "quest": {
              "$ref": "#/$defs/id"
            },
            "step": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trial"],
          "properties": {
            "trial": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cue"],
          "properties": {
            "cue": {
              "description": "A world beat the island's session plays (the game's).",
              "type": "string",
              "pattern": "^[a-z0-9-]+(:[\\w.-]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["askFork"],
          "properties": {
            "askFork": {
              "enum": ["ezra", "crane"]
            },
            "line": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["askSetup"],
          "properties": {
            "askSetup": {
              "enum": ["os", "issue", "branch", "model"]
            },
            "line": {
              "$ref": "#/$defs/id"
            },
            "when": {
              "anyOf": [
                {
                  "enum": ["model:auto", "model:picked", "branch:given", "issue:given"]
                },
                {
                  "type": "string",
                  "pattern": "^app:[A-Za-z0-9][\\w.:-]*$",
                  "description": "A real-app task (learning.json) the player confirmed."
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["appTask"],
          "properties": {
            "appTask": {
              "description": "\"Do this in the app\": a real-app task (learning.json) on a card with I did it and Later.",
              "$ref": "#/$defs/id"
            },
            "quiet": {
              "const": true,
              "description": "No card: the task joins the App checklist as Later (the NPC sends you off, and asks when you're back)."
            },
            "orStop": {
              "const": true,
              "description": "Later ends the script (an optional, app-only quest's return beat: the NPC asks again)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["script"],
          "properties": {
            "script": {
              "description": "Another script of this island, spliced in here.",
              "type": "string"
            }
          }
        }
      ]
    },
    "stepIs": {
      "description": "A quest step name, null (not started), or a list of either.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "description": "Every condition must hold: quest id → its step (a step, null for not started, a list of either, or {\"not\": …}). A key starting with $ is a flag the game passes in (true or false).",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/stepIs"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["not"],
            "properties": {
              "not": {
                "$ref": "#/$defs/stepIs"
              }
            }
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set"],
      "properties": {
        "when": {
          "$ref": "#/$defs/when"
        },
        "set": {
          "description": "Quest id → the step it goes to.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
