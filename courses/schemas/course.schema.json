{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's metadata (courses/<id>/course.json)",
  "description": "What the title screen reads about a course (src/course/catalog.ts): its id, title and tagline, its source (repository, license, chapters), the islands it uses and what the chart and arrivals say about them, and its practice values. docs/specs/COURSE-PACKS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "tagline",
    "description",
    "language",
    "source",
    "islands",
    "practice"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "description": "The pack's folder name.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "tagline": {
      "description": "The title screen's line under the game's name.",
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo", "ref", "license", "copyright", "chapters"],
      "properties": {
        "kind": {
          "const": "github"
        },
        "repo": {
          "description": "owner/name on GitHub.",
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "copyright": {
          "$ref": "#/$defs/text"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "short", "title"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d{2}-[a-z0-9-]+$"
              },
              "short": {
                "type": "string",
                "pattern": "^ch\\d{2}$"
              },
              "title": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "islands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["island", "chapter", "label", "minutes", "topics"],
        "properties": {
          "island": {
            "description": "The game's island id.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "chapter": {
            "type": "string",
            "pattern": "^\\d{2}-[a-z0-9-]+$"
          },
          "label": {
            "description": "The chart's chapter label: \"00 · Setup\".",
            "type": "string",
            "pattern": "^\\d{2} · .+$"
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "seal": {
            "$ref": "#/$defs/text"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "arrival": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eyebrow", "line"],
            "properties": {
              "eyebrow": {
                "$ref": "#/$defs/text"
              },
              "line": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "issueTitle", "branch", "repoName"],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "issueTitle": {
          "$ref": "#/$defs/text"
        },
        "branch": {
          "type": "string",
          "pattern": "^[\\w./+-]+$"
        },
        "repoName": {
          "type": "string",
          "pattern": "^[\\w.-]+$"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
