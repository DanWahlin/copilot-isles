{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's voice lines (courses/<id>/voice/lines.json)",
  "description": "Every voiced line: its id, speaker, engine, voice and text. tools/voice/generate.ts --course <id> makes the audio in the pack's public/voice/ (docs/voices.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["set", "lines"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "set": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speaker", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][\\w.-]*$"
          },
          "speaker": {
            "$ref": "#/$defs/text"
          },
          "text": {
            "description": "What the line says, word for word: it is the caption too.",
            "$ref": "#/$defs/text"
          },
          "tts": {
            "description": "The speech service (default Azure).",
            "enum": ["azure", "elevenlabs"]
          },
          "model": {
            "description": "ElevenLabs model id (default eleven_v3).",
            "type": "string"
          },
          "voice": {
            "description": "An Azure voice name, or an ElevenLabs voice id.",
            "$ref": "#/$defs/text"
          },
          "voiceEnv": {
            "description": "An environment variable that names the Azure voice.",
            "type": "string"
          },
          "fallbackVoice": {
            "$ref": "#/$defs/text"
          },
          "prosody": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fx": {
            "enum": ["wingman-bright", "wingman-bird"]
          },
          "sub": {
            "description": "Whole words to say differently (an SSML <sub>; subtitles keep the word).",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
