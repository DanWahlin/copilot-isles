{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's route puzzle (courses/<id>/puzzles/<name>.json)",
  "description": "Send each flow to its own end without crossing (the sluice's water to the wheel, each crew's channel to its wheel). The board and its tiles are the game's; `crews` name what flows, `signs` letter the site, `demo` and `twist` are the set-up and the closing question. Every puzzle file has an `id`, its `mechanic`, and may set `disabled` (the site stays as scenery), `text` (its words by key, `{name}` filled in by the game) and `lines` (its voice line ids by what they're for). docs/specs/COURSE-PACKS.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mechanic"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mechanic": {
      "const": "route"
    },
    "disabled": {
      "type": "boolean",
      "description": "The course turns this puzzle off: its site stays as scenery and its cue does nothing."
    },
    "text": {
      "type": "object",
      "description": "The puzzle's words by key (labels, hints, readouts, signs).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "description": "Voice line ids (voice/lines.json) by what they're for.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\w.-]+$"
      }
    },
    "signs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/text"
        },
        "minItems": 1
      }
    },
    "crews": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "float", "icon", "iconName"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "float": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "iconName": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kicker", "title", "text"],
        "properties": {
          "kicker": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "twist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "choices"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "right", "line"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "boolean"
              },
              "line": {
                "type": "string",
                "pattern": "^[\\w.-]+$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
