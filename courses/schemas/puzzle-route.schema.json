{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's route puzzle (courses/<id>/puzzles/<name>.json)",
  "description": "Send each flow to its own end without crossing (the sluice's water to the wheel, each crew's channel to its wheel). The board and its tiles are the game's; `crews` name what flows, `signs` letter the site, `demo` and `twist` are the set-up and the closing question. Every puzzle file has an `id`, its `mechanic`, and may set `disabled` (the site stays as scenery), `text` (its words by key, `{name}` filled in by the game) and `lines` (its voice line ids by what they're for). docs/specs/COURSE-PACKS.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mechanic"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mechanic": {
      "const": "route"
    },
    "quest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.:-]*$",
      "description": "The quest the puzzle plays in (a quest of this course): the steps its mechanic sets and waits on (PUZZLE_STEPS, src/course/puzzles.ts) are that quest's."
    },
    "steps": {
      "type": "object",
      "description": "The mechanic's steps (PUZZLE_STEPS) that the quest calls something else: game step → the quest's step.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "disabled": {
      "type": "boolean",
      "description": "The course turns this puzzle off: its site stays as scenery and its cue does nothing."
    },
    "text": {
      "type": "object",
      "description": "The puzzle's words by key (labels, hints, readouts, signs).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "description": "Voice line ids (voice/lines.json) by what they're for.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\w.-]+$"
      }
    },
    "signs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/text"
        },
        "minItems": 1
      }
    },
    "crews": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acts", "name", "float", "icon", "iconName", "sign"],
        "properties": {
          "acts": {
            "enum": ["blue", "green", "teal"],
            "description": "The game's crew it is."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "float": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "iconName": {
            "type": "string",
            "minLength": 1
          },
          "sign": {
            "type": "string",
            "minLength": 1,
            "description": "Its treehouse's sign on Thousand-Bough."
          }
        }
      },
      "description": "Channel Routing: the course's crews, keyed by its own ids, each bound to one of the game's crews (the colour of its water: blue, green, teal), each once."
    },
    "demo": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kicker", "title", "text"],
        "properties": {
          "kicker": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "twist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "choices"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "acts", "text", "right", "line"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "acts": {
                "enum": ["reroute", "close", "jam", "none"],
                "description": "What it does at the Spire: reroute (the second crew to the second lookout), close (the first crew's lantern closes), jam (they share: the jam plays again), none. A right answer reroutes or closes."
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "boolean"
              },
              "line": {
                "type": "string",
                "pattern": "^[\\w.-]+$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
