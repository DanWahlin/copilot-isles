{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's choose-tool puzzle (courses/<id>/puzzles/<name>.json)",
  "description": "Pick the tool (or mode) that fits the job: the right one does it, a wrong one gets its reason. For first-words: the speaking tube or the hatch; for the Three Helms (Copilot app only): the session mode for each order. Every puzzle file has an `id`, its `mechanic`, and may set `disabled` (the site stays as scenery), `text` (its words by key, `{name}` filled in by the game) and `lines` (its voice line ids by what they're for). docs/specs/COURSE-PACKS.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mechanic"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mechanic": {
      "const": "choose-tool"
    },
    "disabled": {
      "type": "boolean",
      "description": "The course turns this puzzle off: its site stays as scenery and its cue does nothing."
    },
    "text": {
      "type": "object",
      "description": "The puzzle's words by key (labels, hints, readouts, signs).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "description": "Voice line ids (voice/lines.json) by what they're for.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\w.-]+$"
      }
    },
    "quiz": {
      "type": "string",
      "description": "The quiz it asks first, if any."
    },
    "tools": {
      "type": "object",
      "minProperties": 2
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "hatch": {
      "type": "object"
    },
    "reply": {
      "type": "object"
    },
    "scripts": {
      "type": "object",
      "description": "Script steps it plays, by name (as in quests/<island>.json).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "minProperties": 1
        },
        "minItems": 1
      }
    },
    "modes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "says"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "says": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "orders": {
      "type": "object",
      "minProperties": 1
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "enum": ["approve", "exit", "suggest"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "orderHints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
