{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A course pack's match puzzle (courses/<id>/puzzles/<name>.json)",
  "description": "Match each one (a crew) to the place that fits its order. `places` come in key order; each order lists every right place (`accept`, `best` among them) and what the others say (`why`). A puzzle the course runs has its mechanic's fields; a `\"disabled\": true` file needs none. Every puzzle file has an `id`, its `mechanic`, and may set `disabled` (the site stays as scenery), `text` (its words by key, `{name}` filled in by the game) and `lines` (its voice line ids by what they're for). docs/specs/COURSE-PACKS.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mechanic"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mechanic": {
      "const": "match"
    },
    "disabled": {
      "type": "boolean",
      "description": "The course turns this puzzle off: its site stays as scenery and its cue does nothing."
    },
    "text": {
      "type": "object",
      "description": "The puzzle's words by key (labels, hints, readouts, signs).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "description": "Voice line ids (voice/lines.json) by what they're for.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[\\w.-]+$"
      }
    },
    "places": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "icon", "island"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "island": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "orders": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "best", "accept", "why"],
        "properties": {
          "order": {
            "type": "string",
            "minLength": 1
          },
          "best": {
            "type": "string",
            "minLength": 1
          },
          "accept": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "right": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "why": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
