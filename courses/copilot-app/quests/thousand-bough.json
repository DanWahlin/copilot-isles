  "notes": {
    "fen": "Fen's welcome: the shared trough (Without isolation): the crews' water mixes while he says why, then the trough comes down and the Gate Board opens.",
    "fen.solved": "Fen's close once the twist's settled (played at once by the puzzle, or when you talk to him).",
    "ines": "The four flags, \"less is more\" and dropping a file on a session, then six orders to practise them (the hoist), and a check that carries the tip to a new job (K2.3).",
    "elder": "Leaving the Trial ends the script; next time the Elder skips her introduction.",
    "barks.tb_kid_a": "The second bark paraphrases 02 · why-the-github-copilot-app-uses-worktrees.",
    "barks.tb_weaver": "The first bark paraphrases 02 · context-syntax.",
    "barks.tb_lookout": "Jory stands on the lookout once the Channel Routing twist is done; the first bark paraphrases 02 · two-previews-collided."
  },
  "barks": {
    "tb_kid_a": ["Race you to the rope swing!", "My treehouse, my branch. Nobody tracks mud in."],
    "tb_kid_b": ["Teo, wait for me!", "When the Beacon lights, every lantern on the tree lights too!"],
    "tb_weaver": [
      "Less is often more, Captain. Don’t bring the whole library.",
      "One trunk, a thousand boughs. I’ve woven every rope bridge on them."
    ],
    "tb_operator": [
      "The Sky Basket only runs once the Elder sends it down.",
      "Up and down all day. Best view on the island, mind."
    ],
    "tb_fisher": [
      "The mist rolls in every evening. You get used to it.",
      "Up in those boughs, every crew minds its own branch. Quieter that way."
    ],
    "tb_lookout": [
      "Two lanterns on one lookout? That’s a jam on the bridge.",
      "Feature’s on 5173 and Docs is on 5174. No more jams."
    ]
  }
}
