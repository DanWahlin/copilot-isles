  "island": "keelhaven",
  "tracker": {
    "chapter": "Chapter 03 · Dev & GitHub Workflows",
    "goal": "Trust the evidence in both loops, and earn the Seal of Keelhaven",
    "next": "Guildcrest is next, and she’s still being charted. Until then these waters are yours."
  },
  "quests": [
    {
      "id": "Q3.1",
      "title": "The Second Take",
      "task": "Hear the Bard’s tale",
      "steps": {
        "start": "Lyra’s playing on the tavern porch, at the quay’s east end.",
        "done": "Record, listen, adjust, record again: that’s the inner loop. The producer’s checks are the outer loop."
      }
    },
    {
      "id": "Q3.2",
      "title": "Trust the Evidence",
      "task": "Learn what counts as evidence",
      "steps": {
        "start": "Hester’s Evidence Board stands by the river bridge.",
        "done": "The diff, the tests and build, the running app and GitHub checks each answer their own question. You judge in both loops."
      }
    },
    {
      "id": "Q3.3",
      "title": "A Known-Good Hull",
      "task": "Prove a known-good baseline",
      "link": {
        "label": "Check the baseline in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#confirm-the-sample-app-is-ready"
      },
      "steps": {
        "start": "Dory’s at Drydock 1, up the ramp.",
        "done": "Four tests pass and the build works before you change anything. Each new worktree needs its own npm install."
      }
    },
    {
      "id": "Q3.4",
      "title": "The Drydock Ring",
      "task": "Walk the inner loop",
      "link": {
        "label": "Fix the bug in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#1-review-and-fix-a-bug"
      },
      "steps": {
        "start": "Cass runs Drydock 2.",
        "ring": "Walk the Drydock Ring: plan, change, inspect, test and build, preview.",
        "solved": "Every lamp on the ring is green. Talk to Cass.",
        "done": "Plan, change, inspect, test, build and preview. Repeat when the evidence shows a problem."
      }
    },
    {
      "id": "Q3.5",
      "title": "The Tide Gauge",
      "task": "Add a regression test",
      "link": {
        "label": "Add the regression test in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#2-add-a-regression-test"
      },
      "steps": {
        "start": "Talk to Cass again at Drydock 2.",
        "ring": "One more lap: bolt on the gauge.",
        "solved": "The gauge holds. Talk to Cass.",
        "done": "A regression test fails with the bug and passes with the fix. Don’t weaken an expectation."
      }
    },
    {
      "id": "Q3.6",
      "title": "A Second Opinion",
      "task": "Ask for a second opinion",
      "link": {
        "label": "Ask for a second opinion in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#3-ask-for-a-second-opinion"
      },
      "steps": {
        "start": "Barty lodges in the Old Hulk, across the basin.",
        "done": "The rubber duck agent critiques your evidence before a pull request. You decide what to fix."
      }
    },
    {
      "id": "Q3.7",
      "title": "Two Ledgers",
      "task": "Find work in Issues and Pull requests",
      "link": {
        "label": "Find your work in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#4-find-work-in-issues-and-pull-requests"
      },
      "steps": {
        "start": "Stroud keeps the harbour office at Lock 1.",
        "done": "Filters belong to the selected view: check the query’s repo: term when you change tabs. The practice pull requests are on Authored by me."
      }
    },
    {
      "id": "Q3.8",
      "title": "The Lock Flight",
      "task": "Go from an issue to a pull request",
      "link": {
        "label": "Open the pull request in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#5-start-from-an-issue-and-open-a-pull-request"
      },
      "steps": {
        "start": "Talk to Stroud again at Lock 1.",
        "flight": "Take the hull through Lock 1.",
        "solved": "Your hull waits in the basin. Talk to Stroud.",
        "done": "Start from the bug’s branch, check the diff, claim only what you saw, open the pull request, and don’t merge it."
      }
    },
    {
      "id": "Q3.9",
      "title": "Notes and Lamps",
      "task": "Answer a review comment and a failing check",
      "link": {
        "label": "Answer the comment and the check in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#6-address-review-comments-and-failing-checks"
      },
      "steps": {
        "start": "Arlo keeps Lock 2.",
        "flight": "Bring both hulls through Lock 2.",
        "solved": "Both hulls are through. Talk to Arlo.",
        "done": "Answer the whole comment. Fix the code, not the test. Don’t mark a pull request ready until the local and GitHub evidence agree."
      }
    },
    {
      "id": "Q3.10",
      "title": "The Gate Light",
      "task": "Pass the Trial to earn the Seal",
      "steps": {
        "start": "Ottoline keeps the Gate Light, through the rock cut.",
        "exam": "Ottoline’s Trial is ready when you are.",
        "done": "The Seal of Keelhaven is yours."
      }
    },
    {
      "id": "Q3.A",
      "title": "Your Turn: Both Loops",
      "task": "Run both loops on a UI task",
      "optional": true,
      "link": {
        "label": "Do the assignment in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#assignment"
      },
      "steps": {
        "start": "Ottoline has one more job for you.",
        "try": "Do the assignment in the app, then show Ottoline.",
        "done": "One focused UI change, an honest summary, and Book app web passes."
      }
    },
    {
      "id": "Q3.B",
      "title": "Pick & Polish",
      "task": "Try Pick & Polish",
      "optional": true,
      "link": {
        "label": "Try Pick & Polish in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/03-development-workflows/README.md#3-ask-for-a-second-opinion"
      },
      "steps": {
        "start": "Barty has a spyglass for you.",
        "try": "Try Pick & Polish in the app, then tell Barty.",
        "done": "Pick & Polish attaches the element you pick to your next prompt."
      }
    }
  ],
