  "notes": {
    "lyra": "The Bard's re-take (puzzles/retake.json, the kh-retake cue): she plays a take, the player finds the bar that rang wrong, and she records again; Salty Sway joins the Songbook.",
    "hester": "The Evidence Board (the kh-board cue) shows M3.1 on its four name boards, then her judgment lines and K3.2.",
    "dory": "Three small acts, each before its line: carrying a tool chest to Drydock 2 (kh-tool-chest: each new worktree needs its own npm install, which the course runs before the tests), sounding four planks and floating the hull (kh-sounding), and the bell cord and the winch (kh-bell-cord). Then the baseline card.",
    "cass": "The Drydock Ring, lap 1 (puzzles/drydock-ring.json): the brief sets the ring step, and the ring opens (kh-ring). The lap’s end sets solved and plays cass.solved at once.",
    "cass.solved": "Lap 1’s close: the fix page is filed (A3.2 has its steps), the validate page and the fix card (A3.2).",
    "cass.lap2": "Lap 2, the regression test: the same ring with a gauge to bolt on.",
    "cass.lap2.solved": "Lap 2’s close: the regression page and card, then chest C3.2 at the dock head opens.",
    "barty": "The second opinion: two lines, then K3.6 is what you do with a critique; then the card (A3.4), whose steps say how to send /rubber-duck and what to do without it. Pick & Polish (Q3.B) starts, optional.",
    "barty.polish": "Optional: the chalk spyglass (kh-chalk-spyglass) marks one sail; the card goes quietly, and Barty asks when you’re back.",
    "barty.polish.back": "Later ends the talk: the quest waits at try, and Barty asks again next time.",
    "stroud": "The outer loop, then the two ledgers (kh-ledgers): add your fork’s repo: term to each view’s query in Query filter mode (03 · 4-find-work-in-issues-and-pull-requests), Stroud’s line on it, K3.7, and the card (A3.5); the page is filed (the card has its steps).",
    "stroud.flight": "The Lock Flight, part 1 (puzzles/lock-flight.json): the order, then the flight opens (kh-flight). The part’s end plays stroud.flight.solved.",
    "stroud.flight.solved": "Part 1’s close: the issue-to-pull-request page and card (A3.6).",
    "arlo": "The Lock Flight, part 2: the note and the red lamp, Gate 2 and the Sea Gate. The part’s end plays arlo.solved.",
    "arlo.solved": "Part 2’s close: Wingman on the two seals, the tug (Agent Merge, chest C3.3), the failing check, both pages filed and both cards (A3.7, A3.8).",
    "ottoline": "Leaving the Trial ends the script; next time Ottoline skips her introduction (ottoline.retry). The reflection comes before the Seal (as built).",
    "trial.passed": "The Seal: kh-seal kindles the Gate Light and the lamps answer down the flight (§4.5).",
    "ottoline.assignment": "Optional, after the Seal: the assignment card goes quietly, and Ottoline asks when you’re back.",
    "ottoline.assignment.back": "Later ends the talk; I did it shows K3.9, the success criteria.",
    "barks.kh_nip": "The second bark paraphrases 03 · confirm-the-sample-app-is-ready.",
    "barks.kh_moll": "The second bark paraphrases 03 · 1-review-and-fix-a-bug.",
    "barks.kh_salter": "The first bark paraphrases 03 · validate-the-fix.",
    "barks.kh_kit": "Both barks paraphrase 03 · fix-a-failing-check.",
    "barks.kh_skipper": "Both barks paraphrase 03 · fix-a-failing-check (Agent Merge, optional)."
  },
  "barks": {
    "kh_nip": [
      "Race you to the slipway, Tuck!",
      "Every dock has its own tool chest. You can’t borrow a hammer through a wall."
    ],
    "kh_tuck": ["Wait for me, Nip!", "When the Gate Light kindles, every lock lamp turns green."],
    "kh_moll": [
      "Mind the planks, Captain.",
      "A plank on the wrong hull? Pry it off, or have the crew revise it."
    ],
    "kh_salter": ["Unread alone? That won’t show you a thing.", "Fish bite better when the lamps are green."],
    "kh_kit": [
      "The lamps light themselves. Lockfall does the work.",
      "A red lamp means read the check, Captain. Don’t file the gauge."
    ],
    "kh_skipper": [
      "I’ll tow a hull out when the harbour allows. Not before.",
      "A finishing aid, that’s me. The captain still reviews."
    ]
