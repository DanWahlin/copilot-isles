{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Model Market's models (content/models.json)",
  "description": "Written by `npm run models:sync` (tools/models/sync.mjs) from GitHub Docs' Copilot model tables. Don't edit by hand. docs/content-data.md, docs/specs/MODEL-MARKET.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "models"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "commit", "fetchedAt"],
      "properties": {
        "repo": { "const": "github/docs" },
        "path": { "const": "data/tables/copilot" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "fetchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provider", "family", "category", "taskArea", "excelsAt", "ga"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "provider": { "enum": ["anthropic", "openai", "microsoft"] },
          "family": { "enum": ["Claude", "GPT", "MAI"] },
          "category": { "enum": ["Lightweight", "Versatile", "Powerful"] },
          "taskArea": { "type": "string" },
          "excelsAt": { "type": "string" },
          "ga": { "type": "boolean" }
        }
      }
    }
  }
}
