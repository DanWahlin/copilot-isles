{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The course lock (content/course.lock.json)",
  "description": "Written by `npm run course:sync` (tools/course/sync.mjs): the bundled course snapshot's commit and a hash for every section and image. Don't edit by hand. docs/content-data.md, docs/course-content-authoring.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "ref", "sha", "syncedAt", "catalog", "chapters", "glossary", "license", "images"],
  "properties": {
    "$comment": { "type": "string" },
    "repo": { "const": "github/copilot-app-for-beginners" },
    "ref": { "type": "string", "minLength": 1 },
    "sha": { "$ref": "#/$defs/sha" },
    "syncedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "num", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/chapter" },
          "num": { "type": "string", "pattern": "^\\d{2}$" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chapters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/chapter" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["short", "title", "hash", "sections"],
        "properties": {
          "short": { "type": "string", "pattern": "^ch\\d{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "hash": { "$ref": "#/$defs/hash" },
          "sections": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/anchor" },
            "additionalProperties": { "$ref": "#/$defs/section" }
          }
        }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "terms"],
      "properties": {
        "hash": { "$ref": "#/$defs/hash" },
        "terms": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/anchor" },
          "additionalProperties": { "$ref": "#/$defs/section" }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": { "hash": { "$ref": "#/$defs/hash" } }
    },
    "images": {
      "description": "Keyed by snapshot path under public/.",
      "type": "object",
      "propertyNames": { "pattern": "^course/[\\w\\-./]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upstream", "bytes"],
        "properties": {
          "upstream": { "type": ["string", "null"] },
          "derivedFrom": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bundled": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "pinned": { "type": "boolean" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "chapter": { "type": "string", "pattern": "^\\d{2}-[a-z0-9-]+$" },
    "anchor": { "type": "string", "pattern": "^[\\p{Ll}\\p{N}_-]+$" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "level", "hash"],
      "properties": {
        "title": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "hash": { "$ref": "#/$defs/hash" },
        "terms": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
