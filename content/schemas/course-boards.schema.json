{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The course notice boards (content/course-boards.json)",
  "description": "Each island's board (its chapter and where it stands), the header and pin text, and the ## sections that aren't topics. The topics come from content/course.lock.json. docs/content-data.md, docs/specs/COURSE-BOARDS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "pins", "skip", "islands"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sign", "kicker"],
      "properties": {
        "sign": {
          "description": "The carved header's lines. {num} is the chapter's number, {title} its title in the course.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/text" }
        },
        "kicker": { "description": "The small line over the title in the overlay.", "$ref": "#/$defs/text" }
      }
    },
    "pins": {
      "description": "The two pins under the topics: the chapter's README, then the course's home.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link", "label", "sign", "text", "aria"],
        "properties": {
          "link": { "enum": ["chapter", "home"] },
          "label": { "description": "The pin's first line.", "$ref": "#/$defs/text" },
          "sign": { "description": "The second line on the board in the world.", "$ref": "#/$defs/text" },
          "text": { "description": "The second line in the overlay.", "$ref": "#/$defs/text" },
          "aria": { "description": "What a screen reader says after the label.", "$ref": "#/$defs/text" }
        }
      }
    },
    "skip": {
      "description": "## sections that aren't topics.",
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "titlePrefixes"],
      "properties": {
        "anchors": {
          "description": "Matched by README anchor.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "titlePrefixes": {
          "description": "Matched by the start of the heading.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "islands": {
      "description": "One board an island, keyed by the island's id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorage", "meridian", "thousand-bough"],
      "properties": {
        "anchorage": { "$ref": "#/$defs/placement" },
        "meridian": { "$ref": "#/$defs/placement" },
        "thousand-bough": { "$ref": "#/$defs/placement" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter", "where", "x", "y", "z", "rot"],
      "properties": {
        "chapter": {
          "description": "The course chapter the board shows (a folder in content/course.lock.json).",
          "type": "string",
          "pattern": "^\\d{2}-[a-z0-9-]+$"
        },
        "where": { "description": "Where it stands, in words.", "$ref": "#/$defs/text" },
        "x": { "description": "World metres.", "type": "number" },
        "y": { "description": "The ground under it (world metres).", "type": "number", "minimum": 0 },
        "z": { "description": "World metres.", "type": "number" },
        "rot": {
          "description": "Yaw in radians (the board faces local +z).",
          "type": "number",
          "minimum": -6.2832,
          "maximum": 6.2832
        }
      }
    }
  }
}
