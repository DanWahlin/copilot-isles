{
  "name": "copilot-isles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Copilot Isles: a browser island adventure that teaches the GitHub Copilot app for Beginners course.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:budgets": "node tools/check-budgets.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "toolchain": "bash tools/setup-toolchain.sh",
    "toolchain:check": "node tools/check-toolchain.mjs",
    "bake": "tsx tools/bake/bake-terrain.ts",
    "prebuild": "npm run bake",
    "predev": "npm run bake",
    "bench": "node tools/bench.mjs --base=http://127.0.0.1:5301 --out=docs/reports/phase0-bench",
    "shots": "node tools/shots.mjs --base=http://127.0.0.1:5301 --out=tests/visual/baseline",
    "shots:compare": "node tools/visual-compare.mjs --base=tests/visual/baseline --candidate=test-results/visual"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
